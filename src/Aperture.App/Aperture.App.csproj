<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WinUI 3 desktop shell. Builds only on Windows (the XAML compiler is a
    Windows tool). Runs unpackaged and self-contained so no Windows App SDK
    runtime installer is needed during development. See docs/build-and-test.md.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Aperture.App</RootNamespace>
    <AssemblyName>Aperture</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aperture.Core\Aperture.Core.csproj" />
    <ProjectReference Include="..\Aperture.Data\Aperture.Data.csproj" />
    <ProjectReference Include="..\Aperture.Media\Aperture.Media.csproj" />
    <ProjectReference Include="..\Aperture.Playback.Mpv\Aperture.Playback.Mpv.csproj" />
    <ProjectReference Include="..\Aperture.Video\Aperture.Video.csproj" />
    <ProjectReference Include="..\Aperture.YouTube\Aperture.YouTube.csproj" />
  </ItemGroup>

  <!-- The page that hosts YouTube's embedded player, served to WebView2 from a virtual host. -->
  <ItemGroup>
    <Content Include="Assets\YouTube\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    libmpv is not committed. tools/Get-Libmpv.ps1 downloads the build pinned in
    third_party/libmpv.json (checking its SHA-256) the first time the app is built for a
    platform, and the DLL is copied next to Aperture.exe.
  -->
  <Target Name="FetchLibmpv" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' != ''">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Get-Libmpv.ps1&quot; -RuntimeIdentifier $(RuntimeIdentifier)" />
  </Target>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <Content Include="..\..\third_party\bin\$(RuntimeIdentifier)\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The media server is a separate program (src/Aperture.Server) so it can keep running after
    the app closes. It is published self-contained for the same platform into Server\ next to
    Aperture.exe, where Settings › Media server starts it. See docs/media-server.md.
  -->
  <Target Name="PublishMediaServer" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' != ''">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\Aperture.Server\Aperture.Server.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained -nologo -o &quot;$(OutDir)Server&quot;" />
  </Target>

  <Target Name="PublishMediaServerWithApp" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' != ''">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\Aperture.Server\Aperture.Server.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained -nologo -o &quot;$(PublishDir)Server&quot;" />
  </Target>

</Project>
