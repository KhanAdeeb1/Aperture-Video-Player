<?xml version="1.0" encoding="utf-8"?>
<!--
    Aperture design tokens. Every screen references these keys, never raw values.
    The rationale for each value is in docs/design-system.md; change both together.

    Colours are theme resources (use {ThemeResource}) so Windows high-contrast themes
    replace them with system colours. Sizes, spacing, type and motion are static.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Aperture is dark-first; "Default" is the designed dark theme. -->
        <ResourceDictionary x:Key="Default">
            <!-- Surfaces: deep charcoal steps, never pure black outside the video itself. -->
            <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#FF141517" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF1C1D20" />
            <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="#FF26282C" />
            <SolidColorBrush x:Key="SurfaceVideoBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="ArtworkEmptyBrush" Color="#FF202226" />

            <!-- Strokes: hairlines only; separation comes from surface steps first. -->
            <SolidColorBrush x:Key="StrokeSubtleBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="StrokeStrongBrush" Color="#29FFFFFF" />
            <SolidColorBrush x:Key="StrokeHoverBrush" Color="#59FFFFFF" />

            <!-- Text: one hue, four strengths. Tertiary still meets 4.5:1 on SurfaceBase. -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F3F5F7" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8F3F5F7" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8CF3F5F7" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#5CF3F5F7" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FF1B1408" />
            <SolidColorBrush x:Key="TextOnVideoBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnVideoSecondaryBrush" Color="#CCFFFFFF" />

            <!-- The single accent: "Lamp", the warm amber of a projector bulb. Used for
                 progress, the primary action and the current selection; nothing else. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FFF2A93B" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFF6BC63" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#FFD8922A" />

            <!-- Status: errors use a muted coral glyph; text stays neutral. -->
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="#FFE8806C" />

            <!-- Video overlays: scrims for legibility over any picture. -->
            <SolidColorBrush x:Key="VideoTrackBrush" Color="#47FFFFFF" />
            <SolidColorBrush x:Key="VideoBufferedBrush" Color="#73FFFFFF" />
            <SolidColorBrush x:Key="VideoPanelBrush" Color="#E61C1D20" />
            <LinearGradientBrush x:Key="VideoBottomScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="0.55" Color="#73000000" />
                <GradientStop Offset="1" Color="#B8000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="VideoTopScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#99000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ArtworkScrimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.6" Color="#00000000" />
                <GradientStop Offset="1" Color="#8C000000" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <!-- High contrast: every token maps to a system colour so Windows contrast themes win. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceVideoBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ArtworkEmptyBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StrokeSubtleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StrokeStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StrokeHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TextOnVideoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextOnVideoSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="VideoTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="VideoBufferedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="VideoPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="VideoBottomScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="VideoTopScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ArtworkScrimBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        Feed Aperture's accent into WinUI's own controls (slider, toggle switch,
        progress ring, accent button, focus) so stock controls match. In the dark
        theme WinUI derives its accent fills from SystemAccentColorLight1-3.
    -->
    <Color x:Key="SystemAccentColor">#FFF2A93B</Color>
    <Color x:Key="SystemAccentColorLight1">#FFF2A93B</Color>
    <Color x:Key="SystemAccentColorLight2">#FFF2A93B</Color>
    <Color x:Key="SystemAccentColorLight3">#FFF6BC63</Color>
    <Color x:Key="SystemAccentColorDark1">#FFD8922A</Color>
    <Color x:Key="SystemAccentColorDark2">#FFB87A1E</Color>
    <Color x:Key="SystemAccentColorDark3">#FF8F5D14</Color>

    <!-- Typography: Segoe UI Variable ships with Windows 11; Segoe UI is the fallback. -->
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontText">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Type ramp (px). Five sizes; hierarchy comes from weight and colour as much as size. -->
    <x:Double x:Key="TypeCaptionSize">12</x:Double>
    <x:Double x:Key="TypeBodySize">14</x:Double>
    <x:Double x:Key="TypeBodyLargeSize">16</x:Double>
    <x:Double x:Key="TypeSubtitleSize">20</x:Double>
    <x:Double x:Key="TypeTitleSize">28</x:Double>
    <x:Double x:Key="TypeCaptionLineHeight">16</x:Double>
    <x:Double x:Key="TypeBodyLineHeight">20</x:Double>
    <x:Double x:Key="TypeBodyLargeLineHeight">22</x:Double>
    <x:Double x:Key="TypeSubtitleLineHeight">28</x:Double>
    <x:Double x:Key="TypeTitleLineHeight">36</x:Double>

    <!-- Icon sizes (px) -->
    <x:Double x:Key="IconSmall">12</x:Double>
    <x:Double x:Key="IconMedium">16</x:Double>
    <x:Double x:Key="IconLarge">20</x:Double>
    <x:Double x:Key="IconStatus">32</x:Double>

    <!-- Spacing scale (4 px base). Use these steps only. -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>
    <x:Double x:Key="Space10">40</x:Double>
    <x:Double x:Key="Space12">48</x:Double>
    <x:Double x:Key="Space16">64</x:Double>

    <!-- Layout -->
    <x:Double x:Key="TitleBarHeight">48</x:Double>
    <x:Double x:Key="ControlHeight">32</x:Double>
    <x:Double x:Key="IconButtonSize">40</x:Double>
    <x:Double x:Key="ReadingWidth">640</x:Double>
    <x:Double x:Key="SearchWidth">320</x:Double>
    <Thickness x:Key="PageGutter">40,0,40,0</Thickness>
    <Thickness x:Key="PageGutterNarrow">24,0,24,0</Thickness>

    <!-- Artwork: one proportion (16:9) everywhere, two sizes. -->
    <x:Double x:Key="ArtworkLargeWidth">320</x:Double>
    <x:Double x:Key="ArtworkLargeHeight">180</x:Double>
    <x:Double x:Key="ArtworkSmallWidth">224</x:Double>
    <x:Double x:Key="ArtworkSmallHeight">126</x:Double>
    <x:Double x:Key="ProgressThickness">3</x:Double>

    <!-- Corner radii: small for controls, medium for artwork, large for floating panels. -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>

    <!-- Motion durations live in Theme/Motion.cs because they are applied from code. -->
</ResourceDictionary>
