<?xml version="1.0" encoding="utf-8"?>
<!--
    Aperture design tokens (initial set). Screens reference these keys, never
    raw values. The full scale and the accent color are proposed in
    docs/architecture.md and are finalised in Milestone 2 against real screenshots.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces: deep charcoal, not pure black. -->
    <Color x:Key="SurfaceBaseColor">#FF141517</Color>
    <Color x:Key="SurfaceRaisedColor">#FF1C1D20</Color>
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource SurfaceBaseColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F3F5F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3F3F5F7" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#66F3F5F7" />

    <!-- Type ramp (px) -->
    <x:Double x:Key="TypeCaptionSize">12</x:Double>
    <x:Double x:Key="TypeBodySize">14</x:Double>
    <x:Double x:Key="TypeSubtitleSize">20</x:Double>
    <x:Double x:Key="TypeTitleSize">28</x:Double>

    <!-- Spacing scale (4 px base) -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>

    <!-- Corner radii -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
</ResourceDictionary>
