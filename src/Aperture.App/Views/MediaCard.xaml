<?xml version="1.0" encoding="utf-8"?>
<!--
    A played file or library item: 16:9 artwork with its progress, title and one line of
    context. A check mark marks watched items; a quiet "Check details" tag marks guesses
    the user should confirm. Hover adds a hairline ring; keyboard focus uses the system
    focus visual around the whole card. Right-click or Shift+F10 opens its actions.
-->
<UserControl
    x:Class="Aperture.App.Views.MediaCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button
        x:Name="CardButton"
        AutomationProperties.AutomationId="MediaCard"
        Click="OnInvoke"
        PointerCanceled="OnPointerExited"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited"
        Style="{StaticResource CardButtonStyle}">
        <Button.ContextFlyout>
            <!-- Filled in when it opens, so it only offers what applies to this item. -->
            <MenuFlyout x:Name="CardMenu" Opening="OnMenuOpening" />
        </Button.ContextFlyout>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="Rest" />
                <VisualState x:Name="Hover">
                    <VisualState.Setters>
                        <Setter Target="HoverRing.Opacity" Value="1" />
                        <Setter Target="TitleText.Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel>
            <Grid
                x:Name="Artwork"
                Background="{ThemeResource ArtworkEmptyBrush}"
                CornerRadius="{StaticResource RadiusMedium}"
                SizeChanged="OnArtworkSizeChanged">
                <!-- Designed empty artwork: the title set quietly, for files Windows has no frame for. -->
                <TextBlock
                    x:Name="EmptyTitle"
                    Margin="16"
                    VerticalAlignment="Bottom"
                    FontFamily="{StaticResource FontDisplay}"
                    FontSize="{StaticResource TypeBodyLargeSize}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextTertiaryBrush}"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords" />
                <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                <Border
                    x:Name="ProgressScrim"
                    Background="{ThemeResource ArtworkScrimBrush}"
                    Visibility="Collapsed" />
                <Grid
                    x:Name="ProgressTrack"
                    Height="{StaticResource ProgressThickness}"
                    Margin="12,0,12,12"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource VideoTrackBrush}"
                    CornerRadius="2"
                    Visibility="Collapsed">
                    <Border
                        x:Name="ProgressFill"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AccentBrush}"
                        CornerRadius="2" />
                </Grid>
                <Border
                    x:Name="CheckBadge"
                    Margin="8"
                    Padding="8,2,8,3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource VideoPanelBrush}"
                    CornerRadius="{StaticResource RadiusSmall}"
                    Visibility="Collapsed">
                    <TextBlock
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Check details" />
                </Border>
                <Border
                    x:Name="WatchedBadge"
                    Width="24"
                    Height="24"
                    Margin="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{ThemeResource VideoPanelBrush}"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <FontIcon
                        FontSize="{StaticResource IconSmall}"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Glyph="&#xE73E;"
                        Style="{StaticResource IconGlyphStyle}" />
                </Border>
                <Border
                    BorderBrush="{ThemeResource StrokeSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}" />
                <Border
                    x:Name="HoverRing"
                    BorderBrush="{ThemeResource StrokeHoverBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.12" />
                    </Border.OpacityTransition>
                </Border>
            </Grid>
            <TextBlock
                x:Name="TitleText"
                Margin="0,10,0,0"
                Foreground="{ThemeResource TextSecondaryBrush}"
                Style="{StaticResource CardTitleTextStyle}" />
            <TextBlock
                x:Name="MetaText"
                Margin="0,2,0,0"
                Style="{StaticResource CardMetaTextStyle}" />
        </StackPanel>
    </Button>
</UserControl>
