<?xml version="1.0" encoding="utf-8"?>
<!--
    Playback. Primary task: watch. The video is the only permanent element; the
    timeline and transport fade in on pointer or keyboard activity and fade out after
    the idle delay from Settings while playing. Audio and subtitle choices share one
    button; speed, picture shape, sync and subtitle look, playback info, shortcuts and
    file location live in the More menu, not on the bar, as do sound options, bookmarks,
    A-B looping and Play on a TV, which
    turns this view into a remote for the TV until casting stops. Every action also has a key
    from the user's shortcut map. The video itself is a swap chain drawn by libmpv;
    everything here is ordinary XAML composed above it.
-->
<UserControl
    x:Class="Aperture.App.Views.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aperture.App.Views"
    AutomationProperties.Name="Video player"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

    <UserControl.Resources>
        <local:SecondsToClockConverter x:Key="SecondsToClock" />
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        Background="{ThemeResource SurfaceVideoBrush}"
        PointerExited="OnRootPointerExited"
        PointerMoved="OnRootPointerMoved"
        SizeChanged="OnRootSizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="StatusStates">
                <VisualState x:Name="Opening">
                    <VisualState.Setters>
                        <Setter Target="OpeningPanel.Visibility" Value="Visible" />
                        <Setter Target="OpeningRing.IsActive" Value="True" />
                        <Setter Target="ControlsPanel.Visibility" Value="Collapsed" />
                        <Setter Target="BottomScrim.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Ready" />
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="ErrorPanel.Visibility" Value="Visible" />
                        <Setter Target="ControlsPanel.Visibility" Value="Collapsed" />
                        <Setter Target="BottomScrim.Visibility" Value="Collapsed" />
                        <Setter Target="TopScrim.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ErrorToneStates">
                <VisualState x:Name="CriticalTone" />
                <VisualState x:Name="NeutralTone">
                    <VisualState.Setters>
                        <Setter Target="ErrorGlyph.Foreground" Value="{ThemeResource TextTertiaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Full" />
                <VisualState x:Name="Mini">
                    <VisualState.Setters>
                        <Setter Target="ControlsPanel.Margin" Value="8,0,8,4" />
                        <Setter Target="VolumeSlider.Visibility" Value="Collapsed" />
                        <Setter Target="VolumeButton.Visibility" Value="Collapsed" />
                        <Setter Target="TimeText.Visibility" Value="Collapsed" />
                        <Setter Target="MoreButton.Visibility" Value="Collapsed" />
                        <Setter Target="TracksButton.Visibility" Value="Collapsed" />
                        <Setter Target="InfoPanel.Visibility" Value="Collapsed" />
                        <Setter Target="AdjustPanel.Visibility" Value="Collapsed" />
                        <Setter Target="ShortcutsPanel.Visibility" Value="Collapsed" />
                        <Setter Target="SegmentsPanel.Visibility" Value="Collapsed" />
                        <Setter Target="CastPanel.Visibility" Value="Collapsed" />
                        <Setter Target="BookmarksPanel.Visibility" Value="Collapsed" />
                        <Setter Target="LoopChip.Visibility" Value="Collapsed" />
                        <Setter Target="TimelineMarks.Visibility" Value="Collapsed" />
                        <Setter Target="CastIcon.Visibility" Value="Collapsed" />
                        <Setter Target="CastTitle.Visibility" Value="Collapsed" />
                        <Setter Target="CastDelivery.Visibility" Value="Collapsed" />
                        <Setter Target="NextUpCard.Width" Value="240" />
                        <Setter Target="AudioOnlyText.Visibility" Value="Collapsed" />
                        <Setter Target="FullscreenButton.Visibility" Value="Collapsed" />
                        <Setter Target="ResumeNotice.Visibility" Value="Collapsed" />
                        <Setter Target="TopScrim.Height" Value="56" />
                        <Setter Target="BottomScrim.Height" Value="120" />
                        <Setter Target="ErrorStack.Margin" Value="16" />
                        <Setter Target="ErrorMessage.Visibility" Value="Collapsed" />
                        <Setter Target="ErrorDetail.Visibility" Value="Collapsed" />
                        <Setter Target="ErrorActions.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- libmpv letterboxes inside the panel itself, so the panel always fills the view. -->
        <SwapChainPanel
            x:Name="Surface"
            AutomationProperties.Name="Video"
            IsHitTestVisible="False" />

        <!-- Sound-only files (podcasts, music) have no picture: show what is playing instead of black. -->
        <StackPanel
            x:Name="AudioOnlyPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <Grid
                Width="96"
                Height="96"
                HorizontalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw">
                <Ellipse Stroke="{ThemeResource StrokeStrongBrush}" StrokeThickness="1.5" />
                <FontIcon
                    FontSize="{StaticResource IconStatus}"
                    Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                    Glyph="&#xE8D6;"
                    Style="{StaticResource IconGlyphStyle}" />
            </Grid>
            <TextBlock
                x:Name="AudioOnlyText"
                MaxWidth="480"
                HorizontalTextAlignment="Center"
                Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                Style="{StaticResource BodyTextStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <!-- Click toggles play; double-click toggles fullscreen; the wheel changes volume. -->
        <Border
            x:Name="InputLayer"
            Background="Transparent"
            DoubleTapped="OnVideoDoubleTapped"
            PointerWheelChanged="OnVideoWheel"
            Tapped="OnVideoTapped" />

        <!-- ===== Overlay: scrims and controls, faded as one ===== -->
        <Grid x:Name="Overlay">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Grid.OpacityTransition>

            <Border
                x:Name="TopScrim"
                Height="112"
                VerticalAlignment="Top"
                Background="{ThemeResource VideoTopScrimBrush}"
                IsHitTestVisible="False" />
            <Border
                x:Name="BottomScrim"
                Height="200"
                VerticalAlignment="Bottom"
                Background="{ThemeResource VideoBottomScrimBrush}"
                IsHitTestVisible="False" />

            <Grid
                x:Name="ControlsPanel"
                Margin="24,0,24,12"
                VerticalAlignment="Bottom"
                GotFocus="OnControlsGotFocus"
                LostFocus="OnControlsLostFocus"
                PointerEntered="OnControlsPointerEntered"
                PointerExited="OnControlsPointerExited">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Resume notice: after resuming, offers Start over; in "Ask" mode, asks first (paused). -->
                <Border
                    x:Name="ResumeNotice"
                    Margin="4,0,0,12"
                    Padding="16,4,4,4"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource VideoPanelBrush}"
                    CornerRadius="{StaticResource RadiusLarge}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            x:Name="ResumeText"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextOnVideoBrush}"
                            Style="{StaticResource BodyTextStyle}" />
                        <Button
                            x:Name="ResumeButton"
                            AutomationProperties.AutomationId="ResumeButton"
                            Click="OnResumeClick"
                            Content="Resume"
                            Style="{StaticResource ApertureAccentButtonStyle}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="StartOverButton"
                            AutomationProperties.AutomationId="StartOverButton"
                            Click="OnStartOverClick"
                            Content="Start over"
                            Foreground="{ThemeResource AccentBrush}"
                            Style="{StaticResource QuietButtonStyle}" />
                    </StackPanel>
                </Border>

                <!--
                    The timeline, with bookmarks as small ticks and an A-B loop as a band drawn
                    just above its track. Pointing at it shows a preview picture (PreviewCard).
                -->
                <Grid x:Name="TimelineHost" Grid.Row="1">
                    <Slider
                        x:Name="Timeline"
                        AutomationProperties.AutomationId="Timeline"
                        AutomationProperties.Name="Timeline"
                        IsThumbToolTipEnabled="False"
                        Maximum="1"
                        Minimum="0"
                        PointerExited="OnTimelinePointerExited"
                        PointerMoved="OnTimelinePointerMoved"
                        SizeChanged="OnTimelineSizeChanged"
                        StepFrequency="0.5"
                        ValueChanged="OnTimelineValueChanged" />
                    <Canvas
                        x:Name="TimelineMarks"
                        AutomationProperties.AccessibilityView="Raw"
                        IsHitTestVisible="False" />
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="PlayPauseButton"
                        AutomationProperties.AutomationId="PlayPauseButton"
                        AutomationProperties.Name="Pause"
                        Click="OnPlayPauseClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Pause (Space)">
                        <FontIcon
                            x:Name="PlayPauseGlyph"
                            FontSize="{StaticResource IconLarge}"
                            Glyph="&#xE769;"
                            Style="{StaticResource IconGlyphStyle}" />
                    </Button>

                    <Button
                        x:Name="VolumeButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="MuteButton"
                        AutomationProperties.Name="Mute"
                        Click="OnMuteClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Mute (M)">
                        <FontIcon
                            x:Name="VolumeGlyph"
                            Glyph="&#xE767;"
                            Style="{StaticResource IconGlyphStyle}" />
                    </Button>

                    <Slider
                        x:Name="VolumeSlider"
                        Grid.Column="2"
                        Width="96"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="VolumeSlider"
                        AutomationProperties.Name="Volume"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="OnVolumeChanged"
                        Value="100" />

                    <TextBlock
                        x:Name="TimeText"
                        Grid.Column="3"
                        AutomationProperties.AutomationId="TimeText"
                        Style="{StaticResource VideoTimeTextStyle}" />

                    <!-- Only while an A-B loop is set: what repeats, and a click stops it. -->
                    <Button
                        x:Name="LoopChip"
                        Grid.Column="4"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="LoopChip"
                        Click="OnLoopChipClick"
                        Foreground="{ThemeResource AccentBrush}"
                        Style="{StaticResource QuietButtonStyle}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="{StaticResource IconMedium}"
                                Glyph="&#xE8EE;"
                                Style="{StaticResource IconGlyphStyle}" />
                            <TextBlock x:Name="LoopChipText" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource AccentBrush}" />
                            <FontIcon
                                FontSize="{StaticResource IconSmall}"
                                Glyph="&#xE711;"
                                Style="{StaticResource IconGlyphStyle}" />
                        </StackPanel>
                    </Button>

                    <!-- Only while a library episode with a next one is playing. -->
                    <Button
                        x:Name="NextEpisodeButton"
                        Grid.Column="5"
                        AutomationProperties.AutomationId="NextEpisodeButton"
                        AutomationProperties.Name="Next episode"
                        Click="OnNextEpisodeClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Next episode"
                        Visibility="Collapsed">
                        <FontIcon Glyph="&#xE893;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>

                    <Button
                        x:Name="TracksButton"
                        Grid.Column="6"
                        AutomationProperties.AutomationId="TracksButton"
                        AutomationProperties.Name="Audio and subtitles"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Audio and subtitles">
                        <FontIcon Glyph="&#xE7F0;" Style="{StaticResource IconGlyphStyle}" />
                        <Button.Flyout>
                            <MenuFlyout
                                x:Name="TracksMenu"
                                Closed="OnFlyoutClosed"
                                Opened="OnFlyoutOpened"
                                Opening="OnTracksMenuOpening"
                                Placement="TopEdgeAlignedRight">
                                <MenuFlyoutSubItem x:Name="SubtitleMenu" Text="Subtitles" />
                                <MenuFlyoutSubItem x:Name="AudioMenu" Text="Audio" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    x:Name="AddSubtitleItem"
                                    AutomationProperties.AutomationId="AddSubtitleItem"
                                    Click="OnAddSubtitleClick"
                                    Text="Add subtitle file…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="MoreButton"
                        Grid.Column="7"
                        AutomationProperties.AutomationId="MoreButton"
                        AutomationProperties.Name="More options"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="More options">
                        <FontIcon Glyph="&#xE712;" Style="{StaticResource IconGlyphStyle}" />
                        <Button.Flyout>
                            <MenuFlyout
                                x:Name="MoreMenu"
                                Closed="OnFlyoutClosed"
                                Opened="OnFlyoutOpened"
                                Opening="OnMoreMenuOpening"
                                Placement="TopEdgeAlignedRight">
                                <MenuFlyoutItem
                                    x:Name="CastMenuItem"
                                    AutomationProperties.AutomationId="CastMenuItem"
                                    Click="OnCastMenuClick"
                                    Text="Play on a TV">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEC15;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem x:Name="SpeedMenu" Text="Playback speed">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xEC4A;" />
                                    </MenuFlyoutSubItem.Icon>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem x:Name="AspectMenu" Text="Picture shape">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE799;" />
                                    </MenuFlyoutSubItem.Icon>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem x:Name="SoundMenu" AutomationProperties.AutomationId="SoundMenu" Text="Sound">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE995;" />
                                    </MenuFlyoutSubItem.Icon>
                                    <ToggleMenuFlyoutItem
                                        x:Name="ClearDialogueItem"
                                        AutomationProperties.AutomationId="ClearDialogueItem"
                                        Click="OnClearDialogueClick"
                                        Text="Clearer dialogue" />
                                    <ToggleMenuFlyoutItem
                                        x:Name="EvenVolumeItem"
                                        AutomationProperties.AutomationId="EvenVolumeItem"
                                        Click="OnEvenVolumeClick"
                                        Text="Even volume" />
                                </MenuFlyoutSubItem>
                                <ToggleMenuFlyoutItem
                                    x:Name="BookmarksMenuItem"
                                    AutomationProperties.AutomationId="BookmarksMenuItem"
                                    Click="OnBookmarksMenuClick"
                                    Text="Bookmarks and notes">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A4;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutSubItem x:Name="LoopMenu" AutomationProperties.AutomationId="LoopMenu" Text="Loop a section">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE8EE;" />
                                    </MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem
                                        x:Name="LoopStartItem"
                                        AutomationProperties.AutomationId="LoopStartItem"
                                        Click="OnLoopStartClick"
                                        Text="Start the loop here" />
                                    <MenuFlyoutItem
                                        x:Name="LoopEndItem"
                                        AutomationProperties.AutomationId="LoopEndItem"
                                        Click="OnLoopEndClick"
                                        Text="End the loop here" />
                                    <MenuFlyoutItem
                                        x:Name="LoopStopItem"
                                        AutomationProperties.AutomationId="LoopStopItem"
                                        Click="OnLoopStopClick"
                                        Text="Stop looping" />
                                </MenuFlyoutSubItem>
                                <ToggleMenuFlyoutItem
                                    x:Name="AdjustMenuItem"
                                    AutomationProperties.AutomationId="AdjustMenuItem"
                                    Click="OnAdjustMenuClick"
                                    Text="Sync and subtitle look">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE9E9;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem
                                    x:Name="SegmentsMenuItem"
                                    AutomationProperties.AutomationId="SegmentsMenuItem"
                                    Click="OnSegmentsMenuClick"
                                    Text="Intro and credits">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE916;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem
                                    x:Name="InfoMenuItem"
                                    AutomationProperties.AutomationId="InfoMenuItem"
                                    Click="OnInfoMenuClick"
                                    Text="Playback info">
                                    <ToggleMenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE946;" />
                                    </ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Name="ShortcutsMenuItem"
                                    AutomationProperties.AutomationId="ShortcutsMenuItem"
                                    Click="OnShortcutsMenuClick"
                                    Text="Keyboard shortcuts">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE765;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator x:Name="EpisodeSeparator" />
                                <MenuFlyoutItem
                                    x:Name="PreviousEpisodeItem"
                                    AutomationProperties.AutomationId="PreviousEpisodeItem"
                                    Click="OnPreviousEpisodeClick"
                                    Text="Previous episode">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE892;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSubItem
                                    x:Name="ShowMenu"
                                    AutomationProperties.AutomationId="ShowMenu"
                                    Text="This show">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE7F4;" />
                                    </MenuFlyoutSubItem.Icon>
                                    <ToggleMenuFlyoutItem
                                        x:Name="ShowAutoplayItem"
                                        AutomationProperties.AutomationId="ShowAutoplayItem"
                                        Click="OnShowAutoplayClick"
                                        Text="Play next episode automatically" />
                                    <MenuFlyoutSubItem x:Name="ShowIntroMenu" Text="Intros" />
                                    <MenuFlyoutSubItem x:Name="ShowRecapMenu" Text="Recaps" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Name="ShowResetItem"
                                        Click="OnShowResetClick"
                                        Text="Use the choices in Settings" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="OnShowInFolderClick" Text="Show in folder">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="MiniPlayerButton"
                        Grid.Column="8"
                        AutomationProperties.AutomationId="MiniPlayerButton"
                        AutomationProperties.Name="Mini player"
                        Click="OnMiniPlayerClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Mini player (P)">
                        <FontIcon
                            x:Name="MiniPlayerGlyph"
                            Glyph="&#xE8A7;"
                            Style="{StaticResource IconGlyphStyle}" />
                    </Button>

                    <Button
                        x:Name="FullscreenButton"
                        Grid.Column="9"
                        AutomationProperties.AutomationId="FullscreenButton"
                        AutomationProperties.Name="Full screen"
                        Click="OnFullscreenClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Full screen (F)">
                        <FontIcon
                            x:Name="FullscreenGlyph"
                            Glyph="&#xE740;"
                            Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                </Grid>
            </Grid>

            <!--
                Seek preview: a small picture of the video where the pointer is on the timeline,
                with the time under it. Made in the background by a hidden second decoder.
            -->
            <StackPanel
                x:Name="PreviewCard"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                AutomationProperties.AccessibilityView="Raw"
                IsHitTestVisible="False"
                Spacing="4"
                Visibility="Collapsed">
                <Border
                    x:Name="PreviewFrame"
                    Background="{ThemeResource SurfaceVideoBrush}"
                    BorderBrush="{ThemeResource StrokeStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}">
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                </Border>
                <Border
                    Padding="8,2,8,3"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource VideoPanelBrush}"
                    CornerRadius="{StaticResource RadiusSmall}">
                    <TextBlock
                        x:Name="PreviewTime"
                        AutomationProperties.AutomationId="PreviewTime"
                        Style="{StaticResource VideoTimeTextStyle}" />
                </Border>
            </StackPanel>
        </Grid>

        <!--
            ===== Skip and next episode =====
            Bottom right, outside the fading overlay so they stay while the controls hide; they
            move up above the controls while those show. Restrained: one quiet button, or one
            small card. Nothing here starts playback without a visible countdown and Cancel.
        -->
        <StackPanel
            x:Name="CueArea"
            Margin="24,0,24,32"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Spacing="12">
            <Button
                x:Name="SkipButton"
                MinHeight="40"
                Padding="20,8,20,9"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="SkipButton"
                Click="OnSkipClick"
                Content="Skip intro"
                Style="{StaticResource ApertureButtonStyle}"
                Visibility="Collapsed" />

            <Border
                x:Name="NextUpCard"
                Width="320"
                Padding="16,12,16,16"
                AutomationProperties.AutomationId="NextUpCard"
                AutomationProperties.Name="Next episode"
                Background="{ThemeResource VideoPanelBrush}"
                CornerRadius="{StaticResource RadiusLarge}"
                PointerEntered="OnControlsPointerEntered"
                PointerExited="OnControlsPointerExited"
                Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="NextUpCaption"
                        AutomationProperties.AutomationId="NextUpCaption"
                        Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Next episode" />
                    <TextBlock
                        x:Name="NextUpTitle"
                        AutomationProperties.AutomationId="NextUpTitle"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource BodyStrongTextStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <ProgressBar
                        x:Name="NextUpProgress"
                        Margin="0,8,0,4"
                        AutomationProperties.AccessibilityView="Raw"
                        Foreground="{ThemeResource AccentBrush}"
                        Maximum="1"
                        Minimum="0"
                        Visibility="Collapsed" />
                    <StackPanel
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="NextUpPlayButton"
                            AutomationProperties.AutomationId="NextUpPlayButton"
                            Click="OnNextUpPlayClick"
                            Content="Play now"
                            Style="{StaticResource ApertureAccentButtonStyle}" />
                        <Button
                            x:Name="NextUpCancelButton"
                            AutomationProperties.AutomationId="NextUpCancelButton"
                            Click="OnNextUpCancelClick"
                            Content="Cancel"
                            Foreground="{ThemeResource TextOnVideoBrush}"
                            Style="{StaticResource QuietButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Intro and credits: what was found for this file, and the user's corrections ===== -->
        <Border
            x:Name="SegmentsPanel"
            Width="340"
            Margin="24,64,24,0"
            Padding="16,12,16,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.Name="Intro and credits"
            Background="{ThemeResource VideoPanelBrush}"
            CornerRadius="{StaticResource RadiusLarge}"
            GotFocus="OnPanelGotFocus"
            LostFocus="OnPanelLostFocus"
            PointerEntered="OnControlsPointerEntered"
            PointerExited="OnControlsPointerExited"
            Visibility="Collapsed">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level2"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource BodyStrongTextStyle}"
                        Text="Intro and credits" />
                    <Button
                        x:Name="SegmentsCloseButton"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="SegmentsCloseButton"
                        AutomationProperties.Name="Close intro and credits"
                        Click="OnSegmentsCloseClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="{StaticResource IconSmall}" Glyph="&#xE711;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                </Grid>

                <ComboBox
                    x:Name="SegmentKindBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="SegmentKindBox"
                    AutomationProperties.Name="Part of the episode"
                    DropDownClosed="OnFlyoutClosed"
                    DropDownOpened="OnFlyoutOpened"
                    SelectionChanged="OnSegmentKindChanged" />

                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="SegmentTimesText"
                        AutomationProperties.AutomationId="SegmentTimesText"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource BodyStrongTextStyle}" />
                    <TextBlock
                        x:Name="SegmentSourceText"
                        AutomationProperties.AutomationId="SegmentSourceText"
                        Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="MarkStartButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="MarkStartButton"
                        Click="OnMarkStartClick"
                        Content="Starts here"
                        Style="{StaticResource ApertureButtonStyle}" />
                    <Button
                        x:Name="MarkEndButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="MarkEndButton"
                        Click="OnMarkEndClick"
                        Content="Ends here"
                        Style="{StaticResource ApertureButtonStyle}" />
                </Grid>
                <TextBlock
                    x:Name="SegmentHint"
                    AutomationProperties.AutomationId="SegmentHint"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="Pause where it starts or ends, then press the button. Saved for this file only; other releases keep their own times."
                    TextWrapping="WrapWholeWords" />

                <StackPanel Orientation="Vertical" Spacing="0">
                    <Button
                        x:Name="WatchSegmentButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="WatchSegmentButton"
                        Click="OnWatchSegmentClick"
                        Content="Go to the start"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource QuietButtonStyle}" />
                    <Button
                        x:Name="ConfirmSegmentButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="ConfirmSegmentButton"
                        Click="OnConfirmSegmentClick"
                        Content="These times are right"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource QuietButtonStyle}" />
                    <Button
                        x:Name="NoSegmentButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="NoSegmentButton"
                        Click="OnNoSegmentClick"
                        Content="Not in this video"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource QuietButtonStyle}" />
                    <Button
                        x:Name="ResetSegmentButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="ResetSegmentButton"
                        Click="OnResetSegmentClick"
                        Content="Undo my changes"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource QuietButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Playback info: stream and renderer details, toggled with I ===== -->
        <Border
            x:Name="InfoPanel"
            Width="340"
            Margin="24,64,24,0"
            Padding="16,12,16,16"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AutomationProperties.Name="Playback info"
            Background="{ThemeResource VideoPanelBrush}"
            CornerRadius="{StaticResource RadiusLarge}"
            Visibility="Collapsed">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level2"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource BodyStrongTextStyle}"
                        Text="Playback info" />
                    <Button
                        x:Name="InfoCloseButton"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="InfoCloseButton"
                        AutomationProperties.Name="Close playback info"
                        Click="OnInfoCloseClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Close (I)">
                        <FontIcon FontSize="{StaticResource IconSmall}" Glyph="&#xE711;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                </Grid>
                <StackPanel
                    x:Name="InfoSections"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="InfoSections"
                    Spacing="12" />
            </Grid>
        </Border>

        <!-- ===== Sync and subtitle look, toggled with G ===== -->
        <Border
            x:Name="AdjustPanel"
            Width="340"
            Margin="24,64,24,0"
            Padding="16,12,16,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.Name="Sync and subtitle look"
            Background="{ThemeResource VideoPanelBrush}"
            CornerRadius="{StaticResource RadiusLarge}"
            GotFocus="OnPanelGotFocus"
            LostFocus="OnPanelLostFocus"
            PointerEntered="OnControlsPointerEntered"
            PointerExited="OnControlsPointerExited"
            Visibility="Collapsed">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level2"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource BodyStrongTextStyle}"
                        Text="Sync and subtitle look" />
                    <Button
                        x:Name="AdjustCloseButton"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="AdjustCloseButton"
                        AutomationProperties.Name="Close sync and subtitle look"
                        Click="OnAdjustCloseClick"
                        Style="{StaticResource VideoIconButtonStyle}">
                        <FontIcon FontSize="{StaticResource IconSmall}" Glyph="&#xE711;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                </Grid>

                <TextBlock
                    Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="Timing, remembered for this video" />
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Subtitles" />
                    <Button
                        x:Name="SubtitleEarlierButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="SubtitleEarlierButton"
                        Click="OnSubtitleEarlierClick"
                        Style="{StaticResource VideoIconButtonStyle}">
                        <FontIcon Glyph="&#xE738;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                    <TextBlock
                        x:Name="SubtitleOffsetText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SubtitleOffsetText"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource BodyStrongTextStyle}"
                        Text="0 s" />
                    <Button
                        x:Name="SubtitleLaterButton"
                        Grid.Column="3"
                        AutomationProperties.AutomationId="SubtitleLaterButton"
                        Click="OnSubtitleLaterClick"
                        Style="{StaticResource VideoIconButtonStyle}">
                        <FontIcon Glyph="&#xE710;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                    <Button
                        x:Name="SubtitleResetButton"
                        Grid.Column="4"
                        AutomationProperties.AutomationId="SubtitleResetButton"
                        AutomationProperties.Name="Reset subtitle timing"
                        Click="OnSubtitleResetClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Reset subtitle timing">
                        <FontIcon FontSize="{StaticResource IconSmall}" Glyph="&#xE777;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>

                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Sound" />
                    <Button
                        x:Name="AudioEarlierButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="AudioEarlierButton"
                        Click="OnAudioEarlierClick"
                        Style="{StaticResource VideoIconButtonStyle}">
                        <FontIcon Glyph="&#xE738;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                    <TextBlock
                        x:Name="AudioOffsetText"
                        Grid.Row="1"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="AudioOffsetText"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource BodyStrongTextStyle}"
                        Text="0 s" />
                    <Button
                        x:Name="AudioLaterButton"
                        Grid.Row="1"
                        Grid.Column="3"
                        AutomationProperties.AutomationId="AudioLaterButton"
                        Click="OnAudioLaterClick"
                        Style="{StaticResource VideoIconButtonStyle}">
                        <FontIcon Glyph="&#xE710;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                    <Button
                        x:Name="AudioResetButton"
                        Grid.Row="1"
                        Grid.Column="4"
                        AutomationProperties.AutomationId="AudioResetButton"
                        AutomationProperties.Name="Reset sound timing"
                        Click="OnAudioResetClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Reset sound timing">
                        <FontIcon FontSize="{StaticResource IconSmall}" Glyph="&#xE777;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                </Grid>
                <TextBlock
                    x:Name="SyncHint"
                    Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                    Style="{StaticResource CaptionTextStyle}" />

                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="Subtitle look, for every video" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Size" />
                    <ComboBox
                        x:Name="SubtitleSizeBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="PlayerSubtitleSizeBox"
                        AutomationProperties.Name="Subtitle size"
                        DropDownClosed="OnFlyoutClosed"
                        DropDownOpened="OnFlyoutOpened"
                        SelectionChanged="OnSubtitleLookChanged" />
                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Colour" />
                    <ComboBox
                        x:Name="SubtitleColorBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="PlayerSubtitleColorBox"
                        AutomationProperties.Name="Subtitle colour"
                        DropDownClosed="OnFlyoutClosed"
                        DropDownOpened="OnFlyoutOpened"
                        SelectionChanged="OnSubtitleLookChanged" />
                    <TextBlock
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Background" />
                    <ComboBox
                        x:Name="SubtitleBackgroundBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="PlayerSubtitleBackgroundBox"
                        AutomationProperties.Name="Subtitle background"
                        DropDownClosed="OnFlyoutClosed"
                        DropDownOpened="OnFlyoutOpened"
                        SelectionChanged="OnSubtitleLookChanged" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Keyboard shortcuts, toggled with ? or F1 ===== -->
        <Border
            x:Name="ShortcutsPanel"
            MaxWidth="760"
            Margin="48,72,48,96"
            Padding="24,16,24,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Keyboard shortcuts"
            Background="{ThemeResource VideoPanelBrush}"
            CornerRadius="{StaticResource RadiusLarge}"
            GotFocus="OnPanelGotFocus"
            LostFocus="OnPanelLostFocus"
            Visibility="Collapsed">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Foreground="{ThemeResource TextOnVideoBrush}"
                            Style="{StaticResource SectionHeaderTextStyle}"
                            Text="Keyboard shortcuts" />
                        <TextBlock
                            Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Change any of these in Settings › Keyboard shortcuts." />
                    </StackPanel>
                    <Button
                        x:Name="ShortcutsCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="ShortcutsCloseButton"
                        AutomationProperties.Name="Close keyboard shortcuts"
                        Click="OnShortcutsCloseClick"
                        Style="{StaticResource VideoIconButtonStyle}">
                        <FontIcon FontSize="{StaticResource IconSmall}" Glyph="&#xE711;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                </Grid>
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="ShortcutsGrid" ColumnSpacing="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ShortcutsLeft" Spacing="16" />
                        <StackPanel
                            x:Name="ShortcutsRight"
                            Grid.Column="1"
                            Spacing="16" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--
            ===== Casting: the video plays on a TV, and this view is its remote =====
            Covers the paused picture. One heading says where it plays and how it is going; the
            timeline and three transport buttons drive the TV; Stop casting brings it back here.
        -->
        <Grid
            x:Name="CastingPanel"
            AutomationProperties.AutomationId="CastingPanel"
            AutomationProperties.Name="Casting"
            Background="{ThemeResource SurfaceVideoBrush}"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="560"
                Margin="24,48,24,48"
                VerticalAlignment="Center"
                Spacing="8">
                <Grid
                    x:Name="CastIcon"
                    Width="96"
                    Height="96"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw">
                    <Ellipse Stroke="{ThemeResource StrokeStrongBrush}" StrokeThickness="1.5" />
                    <FontIcon
                        FontSize="{StaticResource IconStatus}"
                        Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                        Glyph="&#xEC15;"
                        Style="{StaticResource IconGlyphStyle}" />
                </Grid>
                <TextBlock
                    x:Name="CastHeading"
                    AutomationProperties.AutomationId="CastHeading"
                    AutomationProperties.HeadingLevel="Level1"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextOnVideoBrush}"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SubtitleTextStyle}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    x:Name="CastTitle"
                    Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource BodyTextStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="CastMessage"
                    Margin="0,4,0,0"
                    AutomationProperties.AutomationId="CastMessage"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />

                <Grid Margin="0,24,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="CastPositionText"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="CastPositionText"
                        Style="{StaticResource VideoTimeTextStyle}" />
                    <Slider
                        x:Name="CastTimeline"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="CastTimeline"
                        AutomationProperties.Name="Position on the TV"
                        IsThumbToolTipEnabled="True"
                        Maximum="1"
                        Minimum="0"
                        StepFrequency="1"
                        ThumbToolTipValueConverter="{StaticResource SecondsToClock}"
                        ValueChanged="OnCastTimelineChanged" />
                    <TextBlock
                        x:Name="CastDurationText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource VideoTimeTextStyle}" />
                </Grid>

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="CastBackButton"
                        AutomationProperties.AutomationId="CastBackButton"
                        AutomationProperties.Name="Back 10 seconds"
                        Click="OnCastBackClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Back 10 seconds">
                        <FontIcon Glyph="&#xEB9E;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                    <Button
                        x:Name="CastPlayPauseButton"
                        AutomationProperties.AutomationId="CastPlayPauseButton"
                        AutomationProperties.Name="Pause"
                        Click="OnCastPlayPauseClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Pause (Space)">
                        <FontIcon
                            x:Name="CastPlayPauseGlyph"
                            FontSize="{StaticResource IconLarge}"
                            Glyph="&#xE769;"
                            Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                    <Button
                        x:Name="CastForwardButton"
                        AutomationProperties.AutomationId="CastForwardButton"
                        AutomationProperties.Name="Forward 10 seconds"
                        Click="OnCastForwardClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Forward 10 seconds">
                        <FontIcon Glyph="&#xEB9D;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                </StackPanel>

                <Button
                    x:Name="StopCastingButton"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="StopCastingButton"
                    Click="OnStopCastingClick"
                    Content="Stop casting"
                    Style="{StaticResource ApertureButtonStyle}" />

                <TextBlock
                    x:Name="CastDelivery"
                    Margin="0,24,0,0"
                    AutomationProperties.AutomationId="CastDelivery"
                    Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>

        <!-- ===== Play on a TV: the TVs found on the network, from More › Play on a TV ===== -->
        <Border
            x:Name="CastPanel"
            Width="340"
            Margin="24,64,24,0"
            Padding="16,12,16,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="CastPanel"
            AutomationProperties.Name="Play on a TV"
            Background="{ThemeResource VideoPanelBrush}"
            CornerRadius="{StaticResource RadiusLarge}"
            GotFocus="OnPanelGotFocus"
            LostFocus="OnPanelLostFocus"
            PointerEntered="OnControlsPointerEntered"
            PointerExited="OnControlsPointerExited"
            Visibility="Collapsed">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level2"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource BodyStrongTextStyle}"
                        Text="Play on a TV" />
                    <Button
                        x:Name="CastPanelCloseButton"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="CastPanelCloseButton"
                        AutomationProperties.Name="Close Play on a TV"
                        Click="OnCastPanelCloseClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="{StaticResource IconSmall}" Glyph="&#xE711;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        x:Name="CastSearchRing"
                        Width="16"
                        Height="16"
                        IsActive="False"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="CastPickerStatus"
                        MaxWidth="300"
                        AutomationProperties.AutomationId="CastPickerStatus"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel
                    x:Name="CastRendererList"
                    AutomationProperties.AutomationId="CastRendererList"
                    Spacing="4" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="CastStartServerButton"
                        AutomationProperties.AutomationId="CastStartServerButton"
                        Click="OnCastStartServerClick"
                        Content="Start media server"
                        Style="{StaticResource ApertureAccentButtonStyle}"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="CastSearchButton"
                        AutomationProperties.AutomationId="CastSearchButton"
                        Click="OnCastSearchClick"
                        Content="Search again"
                        Foreground="{ThemeResource AccentBrush}"
                        Style="{StaticResource QuietButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>

                <TextBlock
                    Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="Works with TVs and media players that support DLNA, which many Samsung, LG, Sony, Philips and Panasonic TVs do. Not every TV accepts every file. For Chromecast, Apple TV or any other screen, use Windows&#8217; wireless display (Windows+K) or a cable."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <!--
            ===== Bookmarks and notes, from More or Shift+B =====
            Moments marked in this video, earliest first. The time jumps there; the note is
            saved when focus leaves it. B marks the current moment without opening the panel.
        -->
        <Border
            x:Name="BookmarksPanel"
            Width="340"
            MaxHeight="520"
            Margin="24,64,24,0"
            Padding="16,12,16,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="BookmarksPanel"
            AutomationProperties.Name="Bookmarks and notes"
            Background="{ThemeResource VideoPanelBrush}"
            CornerRadius="{StaticResource RadiusLarge}"
            GotFocus="OnPanelGotFocus"
            LostFocus="OnPanelLostFocus"
            PointerEntered="OnControlsPointerEntered"
            PointerExited="OnControlsPointerExited"
            Visibility="Collapsed">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level2"
                        Foreground="{ThemeResource TextOnVideoBrush}"
                        Style="{StaticResource BodyStrongTextStyle}"
                        Text="Bookmarks and notes" />
                    <Button
                        x:Name="BookmarksCloseButton"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="BookmarksCloseButton"
                        AutomationProperties.Name="Close bookmarks"
                        Click="OnBookmarksCloseClick"
                        Style="{StaticResource VideoIconButtonStyle}"
                        ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="{StaticResource IconSmall}" Glyph="&#xE711;" Style="{StaticResource IconGlyphStyle}" />
                    </Button>
                </Grid>
                <Button
                    x:Name="AddBookmarkButton"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="AddBookmarkButton"
                    Click="OnAddBookmarkClick"
                    Content="Bookmark this moment"
                    Style="{StaticResource ApertureButtonStyle}" />
                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        x:Name="BookmarkList"
                        AutomationProperties.AutomationId="BookmarkList"
                        Spacing="4" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== Brief confirmation of a keyboard change (speed, tracks, picture shape) ===== -->
        <Border
            x:Name="Toast"
            Margin="24,72,24,0"
            Padding="16,8,16,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource VideoPanelBrush}"
            CornerRadius="{StaticResource RadiusLarge}"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <TextBlock
                x:Name="ToastText"
                MaxWidth="560"
                AutomationProperties.AutomationId="ToastText"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextOnVideoBrush}"
                Style="{StaticResource BodyTextStyle}"
                TextWrapping="WrapWholeWords" />
        </Border>

        <!-- ===== Opening ===== -->
        <StackPanel
            x:Name="OpeningPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="Collapsed">
            <ProgressRing
                x:Name="OpeningRing"
                Width="32"
                Height="32"
                IsActive="False" />
            <TextBlock
                x:Name="OpeningText"
                MaxWidth="480"
                HorizontalTextAlignment="Center"
                Foreground="{ThemeResource TextOnVideoSecondaryBrush}"
                Style="{StaticResource BodyTextStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <!-- ===== Error and unsupported file ===== -->
        <Grid
            x:Name="ErrorPanel"
            Background="{ThemeResource SurfaceBaseBrush}"
            Visibility="Collapsed">
            <StackPanel
                x:Name="ErrorStack"
                MaxWidth="460"
                Margin="24,48,24,48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <FontIcon
                    x:Name="ErrorGlyph"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource IconStatus}"
                    Foreground="{ThemeResource StatusCriticalBrush}"
                    Glyph="&#xE783;"
                    Style="{StaticResource IconGlyphStyle}" />
                <TextBlock
                    x:Name="ErrorTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    AutomationProperties.LiveSetting="Assertive"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SubtitleTextStyle}" />
                <TextBlock
                    x:Name="ErrorMessage"
                    Margin="0,8,0,0"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource BodyTextStyle}" />
                <TextBlock
                    x:Name="ErrorDetail"
                    Margin="0,16,0,0"
                    HorizontalTextAlignment="Center"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource CaptionTextStyle}" />
                <StackPanel
                    x:Name="ErrorActions"
                    Margin="0,28,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="ErrorOpenButton"
                        AutomationProperties.AutomationId="ErrorOpenButton"
                        Click="OnErrorOpenClick"
                        Content="Open another file"
                        Style="{StaticResource ApertureAccentButtonStyle}" />
                    <Button
                        x:Name="ErrorRetryButton"
                        AutomationProperties.AutomationId="ErrorRetryButton"
                        Click="OnErrorRetryClick"
                        Content="Try again"
                        Style="{StaticResource ApertureButtonStyle}"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="ErrorRemoveButton"
                        AutomationProperties.AutomationId="ErrorRemoveButton"
                        Click="OnErrorRemoveClick"
                        Content="Remove from history"
                        Style="{StaticResource ApertureButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
                <Button
                    x:Name="ErrorCopyButton"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="ErrorCopyButton"
                    Click="OnErrorCopyClick"
                    Content="Copy details for a bug report"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Style="{StaticResource QuietButtonStyle}"
                    ToolTipService.ToolTip="Copies what went wrong and the end of Aperture’s log, with file and folder names removed. Nothing is sent anywhere." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
