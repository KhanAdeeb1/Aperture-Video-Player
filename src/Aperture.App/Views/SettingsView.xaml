<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings. Primary task: change one preference and leave. A single reading-width
    column of rows; every row changes real behaviour and saves immediately. Rarely
    changed things (shortcuts, library folders, online details) live here rather than
    on the player or library screens.
-->
<UserControl
    x:Class="Aperture.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer x:Name="Scroller" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource ReadingWidth}"
            Margin="24,8,24,48"
            HorizontalAlignment="Stretch">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextStyle}"
                Text="Settings" />

            <!-- Playback -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingGroupHeaderTextStyle}"
                Text="Playback" />
            <StackPanel Spacing="2">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="When a video was left part-way" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="What happens when you open something you didn’t finish." />
                    </StackPanel>
                    <ComboBox
                        x:Name="ResumeBox"
                        Grid.Column="1"
                        MinWidth="220"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ResumeBox"
                        AutomationProperties.Name="When a video was left part-way"
                        SelectionChanged="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Hide controls after" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="How long the player waits before hiding its controls and the pointer." />
                    </StackPanel>
                    <ComboBox
                        x:Name="HideDelayBox"
                        Grid.Column="1"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="HideDelayBox"
                        AutomationProperties.Name="Hide controls after"
                        SelectionChanged="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Keep voices natural at other speeds" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Keeps the pitch of speech the same when playing faster or slower." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="PitchToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="PitchToggle"
                        AutomationProperties.Name="Keep voices natural at other speeds"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Keyboard shortcuts" />
                        <TextBlock
                            x:Name="ShortcutsCaption"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="See every key the player uses, and change any of them." />
                    </StackPanel>
                    <Button
                        x:Name="ShortcutsButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ShortcutsButton"
                        Click="OnShortcutsClick"
                        Content="Customize…"
                        Style="{StaticResource ApertureButtonStyle}" />
                </Grid>
            </StackPanel>

            <!-- Subtitles -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingGroupHeaderTextStyle}"
                Text="Subtitles" />
            <StackPanel Spacing="2">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Size" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Applies to text subtitles. Picture-based subtitles (DVD, Blu-ray) keep their own look." />
                    </StackPanel>
                    <ComboBox
                        x:Name="SubtitleSizeBox"
                        Grid.Column="1"
                        MinWidth="160"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SubtitleSizeBox"
                        AutomationProperties.Name="Subtitle size"
                        SelectionChanged="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Colour" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Yellow can be easier to read over bright pictures." />
                    </StackPanel>
                    <ComboBox
                        x:Name="SubtitleColorBox"
                        Grid.Column="1"
                        MinWidth="160"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SubtitleColorBox"
                        AutomationProperties.Name="Subtitle colour"
                        SelectionChanged="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Background" />
                        <TextBlock
                            x:Name="SubtitleBackgroundCaption"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="A dark box behind each line helps over busy pictures." />
                    </StackPanel>
                    <ComboBox
                        x:Name="SubtitleBackgroundBox"
                        Grid.Column="1"
                        MinWidth="160"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SubtitleBackgroundBox"
                        AutomationProperties.Name="Subtitle background"
                        SelectionChanged="OnSettingChanged" />
                </Grid>
            </StackPanel>

            <!-- TV episodes -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingGroupHeaderTextStyle}"
                Text="TV episodes" />
            <StackPanel Spacing="2">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Play the next episode automatically" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="After a short countdown that you can cancel. A show can have its own choice, set from the player’s More menu." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="AutoplayToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="AutoplayToggle"
                        AutomationProperties.Name="Play the next episode automatically"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Countdown" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="How long the next episode waits before it starts." />
                    </StackPanel>
                    <ComboBox
                        x:Name="CountdownBox"
                        Grid.Column="1"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="CountdownBox"
                        AutomationProperties.Name="Next episode countdown"
                        SelectionChanged="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Intros" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Skipping automatically only happens when Aperture is sure where the intro is; otherwise you get the button." />
                    </StackPanel>
                    <ComboBox
                        x:Name="IntroSkipBox"
                        Grid.Column="1"
                        MinWidth="240"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="IntroSkipBox"
                        AutomationProperties.Name="Intros"
                        SelectionChanged="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Recaps" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="“Previously on…” at the start of an episode." />
                    </StackPanel>
                    <ComboBox
                        x:Name="RecapSkipBox"
                        Grid.Column="1"
                        MinWidth="240"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="RecapSkipBox"
                        AutomationProperties.Name="Recaps"
                        SelectionChanged="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Offer Skip credits" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="When the credits are followed by more of the episode, Skip credits takes you to it." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="CreditsToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="CreditsToggle"
                        AutomationProperties.Name="Offer Skip credits"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Find intros and credits in the background" />
                        <TextBlock
                            x:Name="FindSegmentsCaption"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Compares episodes of each show by their sound and picture. Files are only read, never changed. When off, only episodes you open are checked." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="FindSegmentsToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="FindSegmentsToggle"
                        AutomationProperties.Name="Find intros and credits in the background"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSettingChanged" />
                </Grid>
            </StackPanel>

            <!-- Library -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingGroupHeaderTextStyle}"
                Text="Library" />
            <StackPanel Spacing="2">
                <!-- One row per folder, built in code. -->
                <StackPanel x:Name="FolderRows" Spacing="2" />
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Add a library folder" />
                        <TextBlock
                            x:Name="FolderCaption"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Aperture reads only the folders you add, and never changes, moves or renames files in them." />
                    </StackPanel>
                    <Button
                        x:Name="AddFolderButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="AddFolderButton"
                        Click="OnAddFolderClick"
                        Content="Add folder…"
                        Style="{StaticResource ApertureButtonStyle}" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Look up artwork and details online" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Sends only titles, years and episode numbers to The Movie Database (TMDB). Personal videos and podcasts are never sent. Off by default; the library works fully offline." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="OnlineToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="OnlineToggle"
                        AutomationProperties.Name="Look up artwork and details online"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSettingChanged" />
                </Grid>
                <Grid x:Name="KeyRow" Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="TMDB API key" />
                        <TextBlock
                            x:Name="KeyCaption"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="TMDB needs a free key from your own account. It’s kept in Windows Credential Manager, not in Aperture’s files." />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="Get a key"
                        NavigateUri="https://www.themoviedb.org/settings/api" />
                    <Grid
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,12,0,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox
                            x:Name="KeyBox"
                            AutomationProperties.AutomationId="KeyBox"
                            AutomationProperties.Name="TMDB API key"
                            PasswordChanged="OnKeyChanged"
                            PlaceholderText="Paste your API key or read access token" />
                        <Button
                            x:Name="SaveKeyButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="SaveKeyButton"
                            Click="OnSaveKeyClick"
                            Content="Save"
                            IsEnabled="False"
                            Style="{StaticResource ApertureButtonStyle}" />
                        <Button
                            x:Name="RemoveKeyButton"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="RemoveKeyButton"
                            Click="OnRemoveKeyClick"
                            Content="Remove"
                            Style="{StaticResource ApertureButtonStyle}" />
                    </Grid>
                </Grid>
                <TextBlock
                    Margin="16,8,16,0"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="This product uses the TMDB API but is not endorsed or certified by TMDB." />
            </StackPanel>

            <!-- YouTube -->
            <TextBlock
                x:Name="YouTubeHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingGroupHeaderTextStyle}"
                Text="YouTube" />
            <StackPanel Spacing="2">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Play the next YouTube video automatically" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="When a video from a list ends, the next one starts after a 10-second countdown you can cancel. Separate from TV episodes." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="YouTubeAutoplayToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="YouTubeAutoplayToggle"
                        AutomationProperties.Name="Play the next YouTube video automatically"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="YouTube Data API key" />
                        <TextBlock
                            x:Name="YouTubeKeyCaption"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Needed to search YouTube and show popular videos. Create a key for the YouTube Data API v3 in your own Google Cloud project. It’s kept in Windows Credential Manager." />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="How to get one"
                        NavigateUri="https://developers.google.com/youtube/v3/getting-started" />
                    <Grid
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,12,0,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox
                            x:Name="YouTubeKeyBox"
                            AutomationProperties.AutomationId="YouTubeKeyBox"
                            AutomationProperties.Name="YouTube Data API key"
                            PasswordChanged="OnYouTubeKeyChanged"
                            PlaceholderText="Paste your API key" />
                        <Button
                            x:Name="SaveYouTubeKeyButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="SaveYouTubeKeyButton"
                            Click="OnSaveYouTubeKeyClick"
                            Content="Save"
                            IsEnabled="False"
                            Style="{StaticResource ApertureButtonStyle}" />
                        <Button
                            x:Name="RemoveYouTubeKeyButton"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="RemoveYouTubeKeyButton"
                            Click="OnRemoveYouTubeKeyClick"
                            Content="Remove"
                            Style="{StaticResource ApertureButtonStyle}" />
                    </Grid>
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="YouTube account" />
                        <TextBlock
                            x:Name="YouTubeAccountCaption"
                            AutomationProperties.AutomationId="YouTubeAccountCaption"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <Button
                        x:Name="YouTubeSignInButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="YouTubeSignInButton"
                        Click="OnYouTubeSignInClick"
                        Content="Sign in…"
                        Style="{StaticResource ApertureButtonStyle}" />
                    <!-- The OAuth client: only needed for signing in, so it stays out of the way. -->
                    <Expander
                        x:Name="YouTubeClientExpander"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="YouTubeClientExpander"
                        Header="Google sign-in client">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap">
                                <Run Text="Signing in needs an OAuth client of type “Desktop app” from your Google Cloud project, with the YouTube Data API v3 turned on. Aperture asks only for read-only access. While the project is in “Testing”, Google ends the sign-in after 7 days. Steps are in Aperture’s" />
                                <Hyperlink NavigateUri="https://github.com/KhanAdeeb1/Aperture-Video-Player/blob/HEAD/docs/youtube.md">YouTube setup guide</Hyperlink><Run Text="." />
                            </TextBlock>
                            <TextBox
                                x:Name="YouTubeClientIdBox"
                                AutomationProperties.AutomationId="YouTubeClientIdBox"
                                AutomationProperties.Name="OAuth client ID"
                                Header="Client ID"
                                PlaceholderText="…apps.googleusercontent.com"
                                TextChanged="OnYouTubeClientChanged" />
                            <PasswordBox
                                x:Name="YouTubeClientSecretBox"
                                AutomationProperties.AutomationId="YouTubeClientSecretBox"
                                AutomationProperties.Name="OAuth client secret"
                                Header="Client secret"
                                PasswordChanged="OnYouTubeClientChanged" />
                            <Button
                                x:Name="SaveYouTubeClientButton"
                                AutomationProperties.AutomationId="SaveYouTubeClientButton"
                                Click="OnSaveYouTubeClientClick"
                                Content="Save client"
                                IsEnabled="False"
                                Style="{StaticResource ApertureButtonStyle}" />
                        </StackPanel>
                    </Expander>
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Delete YouTube data" />
                        <TextBlock
                            x:Name="ClearYouTubeCaption"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Forgets Continue watching, Saved, YouTube’s titles and thumbnails and the player’s cookies, and signs out. Your keys stay." />
                    </StackPanel>
                    <Button
                        x:Name="ClearYouTubeButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ClearYouTubeButton"
                        Content="Delete…"
                        Style="{StaticResource ApertureButtonStyle}">
                        <Button.Flyout>
                            <Flyout x:Name="ClearYouTubeFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel MaxWidth="300" Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Delete all YouTube data?" />
                                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="Aperture also asks Google to revoke its access. Nothing on YouTube itself changes." />
                                    <Button
                                        HorizontalAlignment="Right"
                                        AutomationProperties.AutomationId="ConfirmClearYouTubeButton"
                                        Click="OnConfirmClearYouTube"
                                        Content="Delete"
                                        Style="{StaticResource ApertureAccentButtonStyle}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <TextBlock
                    Margin="16,8,16,0"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="Wrap">
                    <Run Text="YouTube is used under the" />
                    <Hyperlink NavigateUri="https://www.youtube.com/t/terms">YouTube Terms of Service</Hyperlink><Run Text=" and the" />
                    <Hyperlink NavigateUri="https://policies.google.com/privacy">Google Privacy Policy</Hyperlink><Run Text=". You can also remove Aperture’s access in your" />
                    <Hyperlink NavigateUri="https://myaccount.google.com/connections">Google Account</Hyperlink><Run Text=". Aperture is not made or endorsed by YouTube or Google." />
                </TextBlock>
            </StackPanel>

            <!-- Media server -->
            <TextBlock
                x:Name="MediaServerHeader"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingGroupHeaderTextStyle}"
                Text="Media server" />
            <StackPanel Spacing="2">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Watch on your phone or tablet" />
                        <TextBlock
                            x:Name="ServerStatusCaption"
                            AutomationProperties.AutomationId="ServerStatusCaption"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Checking…" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="The server runs on its own, so it keeps going after you close Aperture until you stop it here." />
                    </StackPanel>
                    <Button
                        x:Name="ServerStartButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ServerStartButton"
                        Click="OnServerStartStopClick"
                        Content="Start"
                        IsEnabled="False"
                        Style="{StaticResource ApertureAccentButtonStyle}" />
                </Grid>
                <Grid
                    x:Name="ServerConnectRow"
                    Style="{StaticResource SettingRowStyle}"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Connect a device" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="On the same Wi-Fi, open this address in the phone’s browser. It shows how to trust Aperture’s certificate, once, so the connection is encrypted." />
                        <TextBlock
                            x:Name="ServerSetupText"
                            AutomationProperties.AutomationId="ServerSetupText"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource BodyTextStyle}" />
                        <TextBlock
                            x:Name="ServerFingerprintText"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <Button
                        x:Name="CopySetupButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="CopySetupButton"
                        Click="OnCopySetupClick"
                        Content="Copy address"
                        Style="{StaticResource ApertureButtonStyle}" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Passphrase" />
                        <TextBlock
                            x:Name="PassphraseCaption"
                            AutomationProperties.AutomationId="PassphraseCaption"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <Grid
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox
                            x:Name="PassphraseBox"
                            AutomationProperties.AutomationId="PassphraseBox"
                            AutomationProperties.Name="New passphrase"
                            PasswordChanged="OnPassphraseChanged"
                            PlaceholderText="New passphrase" />
                        <PasswordBox
                            x:Name="PassphraseAgainBox"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="PassphraseAgainBox"
                            AutomationProperties.Name="Type the passphrase again"
                            PasswordChanged="OnPassphraseChanged"
                            PlaceholderText="Type it again" />
                        <Button
                            x:Name="SavePassphraseButton"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="SavePassphraseButton"
                            Click="OnSavePassphraseClick"
                            Content="Save"
                            IsEnabled="False"
                            Style="{StaticResource ApertureButtonStyle}" />
                    </Grid>
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Shared folders" />
                        <TextBlock
                            x:Name="SharedFoldersCaption"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Devices see only the library folders you turn on here. Nothing is shared until you choose, and files are only ever read." />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="SharedFolderRows" Spacing="2" />
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Signed-in devices" />
                        <TextBlock
                            x:Name="DevicesCaption"
                            AutomationProperties.AutomationId="DevicesCaption"
                            Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <Button
                        x:Name="SignOutAllButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SignOutAllButton"
                        Content="Sign out all…"
                        Style="{StaticResource ApertureButtonStyle}">
                        <Button.Flyout>
                            <Flyout x:Name="SignOutAllFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel MaxWidth="300" Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Sign out every device?" />
                                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="They stop playing straight away and need the passphrase to sign in again." />
                                    <Button
                                        HorizontalAlignment="Right"
                                        AutomationProperties.AutomationId="ConfirmSignOutAllButton"
                                        Click="OnConfirmSignOutAll"
                                        Content="Sign out all"
                                        Style="{StaticResource ApertureAccentButtonStyle}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <StackPanel x:Name="DeviceRows" Spacing="2" />
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Keep the computer awake while a device plays" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Stops idle sleep only while something is playing. Closing a laptop’s lid or pressing the power button still sleeps; Aperture never changes your Windows power settings." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="KeepAwakeToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="KeepAwakeToggle"
                        AutomationProperties.Name="Keep the computer awake while a device plays"
                        OffContent=""
                        OnContent=""
                        Toggled="OnServerSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Allow devices on a private network" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="For watching away from home through Tailscale or a similar private network you set up. The server never accepts connections from the internet itself." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="AllowVpnToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="AllowVpnToggle"
                        AutomationProperties.Name="Allow devices on a private network"
                        OffContent=""
                        OnContent=""
                        Toggled="OnServerSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Start the server when I sign in to Windows" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="It starts in the background without opening Aperture." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StartWithWindowsToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="StartWithWindowsToggle"
                        AutomationProperties.Name="Start the server when I sign in to Windows"
                        OffContent=""
                        OnContent=""
                        Toggled="OnServerSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Converting for devices" />
                        <TextBlock
                            x:Name="ConverterCaption"
                            AutomationProperties.AutomationId="ConverterCaption"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Files a device can play are sent as they are. Others are converted on the fly with FFmpeg, which you install yourself; the original is never changed." />
                    </StackPanel>
                    <ComboBox
                        x:Name="ConversionsBox"
                        Grid.Column="1"
                        MinWidth="160"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ConversionsBox"
                        AutomationProperties.Name="Conversions at once"
                        SelectionChanged="OnServerSettingChanged" />
                    <StackPanel
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="ChooseFfmpegButton"
                            AutomationProperties.AutomationId="ChooseFfmpegButton"
                            Click="OnChooseFfmpegClick"
                            Content="Choose ffmpeg.exe…"
                            Style="{StaticResource ApertureButtonStyle}" />
                        <Button
                            x:Name="AutomaticFfmpegButton"
                            AutomationProperties.AutomationId="AutomaticFfmpegButton"
                            Click="OnAutomaticFfmpegClick"
                            Content="Find it automatically"
                            Style="{StaticResource ApertureButtonStyle}"
                            Visibility="Collapsed" />
                        <HyperlinkButton
                            VerticalAlignment="Center"
                            Content="Where to get FFmpeg"
                            NavigateUri="https://github.com/KhanAdeeb1/Aperture-Video-Player/blob/HEAD/docs/media-server.md#ffmpeg" />
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Ports" />
                        <TextBlock
                            x:Name="PortsCaption"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Change these only if another program already uses them. They take effect the next time the server starts." />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <NumberBox
                            x:Name="PortBox"
                            MinWidth="140"
                            AutomationProperties.AutomationId="PortBox"
                            Header="Encrypted (HTTPS)"
                            Maximum="65535"
                            Minimum="1024"
                            SpinButtonPlacementMode="Hidden"
                            ValueChanged="OnPortChanged" />
                        <NumberBox
                            x:Name="SetupPortBox"
                            MinWidth="140"
                            AutomationProperties.AutomationId="SetupPortBox"
                            Header="Setup page"
                            Maximum="65535"
                            Minimum="1024"
                            SpinButtonPlacementMode="Hidden"
                            ValueChanged="OnPortChanged" />
                        <Button
                            x:Name="SavePortsButton"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="SavePortsButton"
                            Click="OnSavePortsClick"
                            Content="Save"
                            IsEnabled="False"
                            Style="{StaticResource ApertureButtonStyle}" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    Margin="16,8,16,0"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="Wrap">
                    <Run Text="Laptops, Windows Firewall and watching away from home are covered in the" />
                    <Hyperlink NavigateUri="https://github.com/KhanAdeeb1/Aperture-Video-Player/blob/HEAD/docs/media-server.md">media server guide</Hyperlink><Run Text="." />
                </TextBlock>
            </StackPanel>

            <!-- History -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingGroupHeaderTextStyle}"
                Text="History" />
            <StackPanel Spacing="2">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Remember played videos" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Keep positions and show recent videos on Home. Turning this off stops recording; it doesn't delete anything." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="RememberToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="RememberToggle"
                        AutomationProperties.Name="Remember played videos"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Clear history" />
                        <TextBlock
                            x:Name="ClearHistoryCaption"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Forget every played video and position. Your video files are not touched." />
                    </StackPanel>
                    <Button
                        x:Name="ClearHistoryButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ClearHistoryButton"
                        Content="Clear…"
                        Style="{StaticResource ApertureButtonStyle}">
                        <Button.Flyout>
                            <Flyout x:Name="ClearFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel MaxWidth="280" Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Clear all history?" />
                                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="Home will be empty and videos will start from the beginning." />
                                    <Button
                                        HorizontalAlignment="Right"
                                        AutomationProperties.AutomationId="ConfirmClearButton"
                                        Click="OnConfirmClear"
                                        Content="Clear history"
                                        Style="{StaticResource ApertureAccentButtonStyle}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- About -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingGroupHeaderTextStyle}"
                Text="About" />
            <StackPanel Spacing="2">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Style="{StaticResource BodyStrongTextStyle}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Preview build. Video and sound are played by libmpv, the engine of the mpv player." />
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Data folder" />
                        <TextBlock
                            x:Name="DataFolderText"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="OpenDataFolderButton"
                        Click="OnOpenDataFolder"
                        Content="Open folder"
                        Style="{StaticResource ApertureButtonStyle}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
