<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings. Primary task: change one preference and leave. A single reading-width
    column of rows; every row changes real behaviour and saves immediately.
-->
<UserControl
    x:Class="Aperture.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="{StaticResource ReadingWidth}"
            Margin="24,8,24,48"
            HorizontalAlignment="Stretch">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextStyle}"
                Text="Settings" />

            <!-- Playback -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingGroupHeaderTextStyle}"
                Text="Playback" />
            <StackPanel Spacing="2">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Resume where you left off" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Start each video from the last position you watched." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="ResumeToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="ResumeToggle"
                        AutomationProperties.Name="Resume where you left off"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Hide controls after" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="How long the player waits before hiding its controls and the pointer." />
                    </StackPanel>
                    <ComboBox
                        x:Name="HideDelayBox"
                        Grid.Column="1"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="HideDelayBox"
                        AutomationProperties.Name="Hide controls after"
                        SelectionChanged="OnSettingChanged" />
                </Grid>
            </StackPanel>

            <!-- History -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingGroupHeaderTextStyle}"
                Text="History" />
            <StackPanel Spacing="2">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Remember played videos" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Keep positions and show recent videos on Home. Turning this off stops recording; it doesn't delete anything." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="RememberToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="RememberToggle"
                        AutomationProperties.Name="Remember played videos"
                        OffContent=""
                        OnContent=""
                        Toggled="OnSettingChanged" />
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Clear history" />
                        <TextBlock
                            x:Name="ClearHistoryCaption"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Forget every played video and position. Your video files are not touched." />
                    </StackPanel>
                    <Button
                        x:Name="ClearHistoryButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ClearHistoryButton"
                        Content="Clear…"
                        Style="{StaticResource ApertureButtonStyle}">
                        <Button.Flyout>
                            <Flyout x:Name="ClearFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel MaxWidth="280" Spacing="12">
                                    <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Clear all history?" />
                                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="Home will be empty and videos will start from the beginning." />
                                    <Button
                                        HorizontalAlignment="Right"
                                        AutomationProperties.AutomationId="ConfirmClearButton"
                                        Click="OnConfirmClear"
                                        Content="Clear history"
                                        Style="{StaticResource ApertureAccentButtonStyle}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- About -->
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SettingGroupHeaderTextStyle}"
                Text="About" />
            <StackPanel Spacing="2">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Style="{StaticResource BodyStrongTextStyle}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Preview build. Video is decoded by Windows Media Foundation until Aperture's own engine arrives." />
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="Data folder" />
                        <TextBlock
                            x:Name="DataFolderText"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="OpenDataFolderButton"
                        Click="OnOpenDataFolder"
                        Content="Open folder"
                        Style="{StaticResource ApertureButtonStyle}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
