<?xml version="1.0" encoding="utf-8"?>
<!--
    Keyboard shortcuts. Primary task: see which key does what, and change one. Rows are
    grouped as in the player's shortcut panel. "Change" waits for the next key press; a
    key that already belongs to another command says which, and can be moved here.
-->
<ContentDialog
    x:Class="Aperture.App.Views.ShortcutsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Keyboard shortcuts"
    CloseButtonText="Done"
    DefaultButton="Close"
    PreviewKeyDown="OnPreviewKeyDown"
    SecondaryButtonClick="OnResetAllClick"
    SecondaryButtonText="Reset all"
    Style="{StaticResource DefaultContentDialogStyle}">

    <Grid Width="480" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource BodyTextStyle}" Text="Keys work while a video is playing and the focus isn’t in a text box. Keys Windows uses everywhere (like Alt+Tab) and Aperture’s own (Ctrl+O, Esc, Tab) can’t be taken." />
        <Border
            x:Name="MessagePanel"
            Grid.Row="1"
            Padding="16,10,12,10"
            Background="{ThemeResource SurfaceOverlayBrush}"
            CornerRadius="{StaticResource RadiusMedium}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="MessageText"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Assertive"
                    Style="{StaticResource BodyTextStyle}" />
                <Button
                    x:Name="MoveKeyButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="MoveKeyButton"
                    Click="OnMoveKeyClick"
                    Content="Use it here"
                    Style="{StaticResource ApertureButtonStyle}"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
        <ScrollViewer
            Grid.Row="2"
            MaxHeight="420"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" Padding="0,0,16,0" />
        </ScrollViewer>
    </Grid>
</ContentDialog>
