<?xml version="1.0" encoding="utf-8"?>
<!--
    The YouTube section. Primary task: find a video and watch it. The most important element
    is Continue watching (videos left part-way in Aperture); Saved, the signed-in account's
    lists and YouTube's popular chart sit below it. Search lives in the title bar, the same
    place as everywhere else, and also takes pasted links. Nothing here imitates YouTube's
    own site: it is Aperture's shelves and cards, with YouTube's titles and thumbnails as given.
    Before first use, one screen states the terms and what Aperture keeps.
-->
<UserControl
    x:Class="Aperture.App.Views.YouTubeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aperture.App.Views">

    <Grid>
        <!-- ===== First use: terms and what Aperture keeps ===== -->
        <ScrollViewer
            x:Name="ConsentScroller"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="560"
                Margin="24,48,24,48"
                HorizontalAlignment="Center"
                Spacing="16">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextStyle}"
                    Text="YouTube in Aperture" />
                <TextBlock
                    FontSize="{StaticResource TypeBodyLargeSize}"
                    LineHeight="{StaticResource TypeBodyLargeLineHeight}"
                    Style="{StaticResource BodyTextStyle}"
                    Text="Watch YouTube videos in YouTube’s own player, pick up where you left off, and keep a list of videos for later, next to your own media." />
                <StackPanel Padding="0,8,0,0" Spacing="12">
                    <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="What works without setup" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="Paste a YouTube link into the search box to watch it here. Continue watching and Saved work for anything you play or save in Aperture." />
                    <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="What needs your own key or sign-in" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="Searching YouTube and its popular videos need a free YouTube Data API key. Your playlists and liked videos need you to sign in with Google (read-only). Both are optional and set up in Settings." />
                    <TextBlock Style="{StaticResource BodyStrongTextStyle}" Text="What Aperture keeps" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="Only the videos you play or save here, with your position, on this PC. Titles and thumbnails from YouTube are refreshed or removed within 30 days. Keys and sign-in stay in Windows Credential Manager. Settings › YouTube deletes all of it at any time. YouTube’s player itself is run by YouTube, under Google’s privacy policy." />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap">
                    <Run Text="By continuing you agree to the" />
                    <Hyperlink NavigateUri="https://www.youtube.com/t/terms">YouTube Terms of Service</Hyperlink><Run Text=". Google’s handling of your data is described in the" />
                    <Hyperlink NavigateUri="https://policies.google.com/privacy">Google Privacy Policy</Hyperlink><Run Text=". Aperture is not made or endorsed by YouTube or Google." />
                </TextBlock>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="AcceptButton"
                        AutomationProperties.AutomationId="YouTubeAcceptButton"
                        Click="OnAcceptClick"
                        Content="Agree and continue"
                        Style="{StaticResource ApertureAccentButtonStyle}" />
                    <Button
                        AutomationProperties.AutomationId="YouTubeNotNowButton"
                        Click="OnNotNowClick"
                        Content="Not now"
                        Style="{StaticResource ApertureButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== The section ===== -->
        <ScrollViewer
            x:Name="MainScroller"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <StackPanel Padding="0,8,0,48">
                <Grid x:Name="HeaderRow" Margin="40,0,40,0">
                    <StackPanel>
                        <TextBlock
                            x:Name="HeaderText"
                            AutomationProperties.AutomationId="YouTubeHeader"
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{StaticResource TitleTextStyle}"
                            Text="YouTube" />
                        <TextBlock
                            x:Name="HeaderCaption"
                            Margin="0,4,0,0"
                            Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <Button
                        x:Name="BackToShelvesButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="YouTubeBackToShelves"
                        Click="OnBackToShelvesClick"
                        Content="Back to YouTube"
                        Style="{StaticResource QuietButtonStyle}"
                        Visibility="Collapsed" />
                </Grid>

                <!-- One quiet line when something needs saying: no key, a failed search, no connection. -->
                <Grid
                    x:Name="NoticeRow"
                    Margin="40,20,40,0"
                    Padding="16,12,12,12"
                    Background="{ThemeResource SurfaceRaisedBrush}"
                    BorderBrush="{ThemeResource StrokeSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="NoticeGlyph"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Glyph="&#xE946;"
                        Style="{StaticResource IconGlyphStyle}" />
                    <TextBlock
                        x:Name="NoticeText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="YouTubeNotice"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource BodyTextStyle}" />
                    <Button
                        x:Name="NoticeButton"
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="YouTubeNoticeButton"
                        Click="OnNoticeButtonClick"
                        Content="Set up…"
                        Style="{StaticResource ApertureButtonStyle}" />
                </Grid>

                <!-- Search results and playlists -->
                <StackPanel x:Name="ResultsSection" Margin="40,24,40,0" Visibility="Collapsed">
                    <ProgressRing
                        x:Name="ResultsRing"
                        Width="32"
                        Height="32"
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        IsActive="False" />
                    <ScrollViewer
                        AutomationProperties.AutomationId="YouTubeResults"
                        AutomationProperties.Name="Results"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollMode="Disabled">
                        <ItemsRepeater x:Name="ResultsRepeater" ElementPrepared="OnResultPrepared">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="16"
                                    MinItemWidth="{StaticResource ArtworkSmallWidth}"
                                    MinRowSpacing="28" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <local:YouTubeCard />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <Button
                        x:Name="MoreButton"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="YouTubeMoreButton"
                        Click="OnMoreClick"
                        Content="Show more"
                        Style="{StaticResource ApertureButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- Shelves, built from what Aperture holds and what the key or sign-in allows. -->
                <StackPanel x:Name="ShelvesHost" />

                <StackPanel
                    x:Name="EmptyPanel"
                    MaxWidth="460"
                    Margin="24,96,24,0"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SubtitleTextStyle}"
                        Text="Paste a YouTube link to start" />
                    <TextBlock
                        x:Name="EmptyDetail"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
