<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SQLite persistence for settings and playback history. Platform-neutral, so its
    tests run on Linux and Windows CI. Schema changes are numbered SQL files in
    Migrations/, embedded as resources and applied in order (PRAGMA user_version).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aperture.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="Aperture.Data.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aperture.Core\Aperture.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aperture.Data.Tests" />
  </ItemGroup>

</Project>
